        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"append_to_existing\": true,\n  \"run_check\": false,\n  \"new_entries\": [\n    {\n      \"first_name\": \"Sample\",\n      \"last_name\": \"User\",\n      \"email\": \"sample@example.com\",\n      \"skills\": [\"Python\"],\n      \"languages\": [\"English\"],\n      \"education\": []\n    }\n  ]\n}"
        },
        "url": {
          "raw": "{{base_url}}/api/v1/retrain-mapping",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "api",
            "v1",
            "retrain-mapping"
          ]
        }
      }
    },
