# OCR Remote Server Configuration

# Server settings
HOST=0.0.0.0
PORT=8000

# CORS settings (allow requests from your Java app)
# Use * for all origins or specify: http://192.168.1.100:8080,http://localhost:8080
CORS_ALLOW_ORIGINS=*

# API Security (choose one method)
# Method 1: Static token
SIMPLYPARSE_API_TOKEN=your-secure-token-change-this

# Method 2: Bearer login (optional, comment out if using static token)
# API_AUTH_SECRET=your-secret-key-change-this
# API_LOGIN_USER=admin
# API_LOGIN_PASSWORD=secure-password-change-this

# Worker settings (if running separate worker process)
ASYNC_WORKER_THREADS=2

# OCR settings
PDF_DPI=220
